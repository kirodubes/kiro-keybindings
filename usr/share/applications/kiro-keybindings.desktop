[Desktop Entry]
Type=Application
Name=Kiro Keybindings
Comment=Searchable keyboard-shortcut cheatsheet for your desktop
Exec=kiro-keybindings
Icon=preferences-desktop-keyboard
Terminal=false
Categories=Utility;
Keywords=keybindings;shortcuts;keys;cheatsheet;hotkeys;
# Hidden on KDE/Plasma until the kiro-plasma spin ships a plasma.keybindings.txt;
# without it the app exits "no keybindings found", so don't surface a dead launcher there.
NotShowIn=KDE;
